{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlideStage",
  "mainBinaryName": "SlideStage",
  "identifier": "app.slidestage.desktop",
  "version": "0.1.2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "SlideStage",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0B0D10",
        "label": "main"
      },
      {
        "title": "SlideStage - Apresentador",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0B0D10",
        "label": "presenter",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "SlideStage",
    "shortDescription": "Estúdio de slides em HTML",
    "longDescription": "SlideStage é um editor visual e de código para criar apresentações em HTML único, com editor visual, modo código, modelos e exportação para qualquer navegador."
  }
}
